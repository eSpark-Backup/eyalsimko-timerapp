{
  "expo": {
    "name": "TOUP Timer",
    "slug": "Timer",
    "version": "1.1.5",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theoneupgroup.timer",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "This app requires access to the local network to connect to Wi-Fi networks.",
        "NSLocationWhenInUseUsageDescription": "This app requires location access to find and connect to nearby Wi-Fi networks."
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true,
        "com.apple.developer.networking.HotspotConfiguration": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "co.theoneupgroup.timer",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "organization": "radion",
          "project": "toug-timer",
          "url": "https://sentry.io/"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "entitlements": {
              "com.apple.developer.networking.wifi-info": true,
              "com.apple.developer.networking.HotspotConfiguration": true
            }
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera"
        }
      ],
      "react-native-wifi-reborn",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "assets/fonts/Poppins-Regular.ttf",
            "assets/fonts/Cousine-Regular.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e27640a0-ad84-44a1-af3f-62d98aefcbd7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e27640a0-ad84-44a1-af3f-62d98aefcbd7"
    }
  }
}
